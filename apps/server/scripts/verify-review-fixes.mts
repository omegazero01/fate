assert.equal(http.filter((v:any)=>v.event==='request'&&v.path==='/first').length,1);assert.equal(http.filter((v:any)=>v.event==='request'&&v.path==='/second').length,2);assert.equal(traffic.length,2);assert.ok(traffic.every((v:any)=>v.status===200));
