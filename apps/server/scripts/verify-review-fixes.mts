const intents=s.nodes.filter((n:any)=>n.kind==='intent'),facts=s.nodes.filter((n:any)=>n.kind==='fact'&&n.state==='confirmed'),first=Number(lifecycle.find((v:any)=>v.event==='before-restart').intent_id),second=intents.find((n:any)=>Number(n.id)!==first);
