const main=lines('main.jsonl');assert.ok(main.find((v:any)=>v.event==='recall')?.reply.reply);assert.ok(s.activity.some((a:any)=>['main','mainagent'].includes(a.worker)&&a.kind==='tool_use'&&['context_get','context_search'].includes(a.tool)));
const result={passed:true,task_id:run.task_id,intent_ids:intents.map((n:any)=>Number(n.id)),fact_ids:facts.map((n:any)=>Number(n.id)),original_intent:first,executor_pids:runs.map((v:any)=>v.pid),pi_session_id:runs[0].session_id,model_requests:requests.filter((v:any)=>v.kind==='model').length,mcp_calls:requests.filter((v:any)=>v.kind==='mcp'&&v.method==='tools/call').length,successful_https_exchanges:traffic.length,first_request_count:1,second_request_count:2,subscribed_segment:1,unsubscribed_segment:2,final_feedback_count:1,planner_prompt_source:'builtin',budgets:'unlimited; 0 turns/seconds and no injected output limit',traffic};
