import {readFileSync,writeFileSync} from 'node:fs';import path from 'node:path';import pg from 'pg';import assert from 'node:assert/strict';
const dir=path.resolve(process.argv[2]??'../../docs/reviews/evidence/review-fixes-20261019');
const read=(name:string)=>JSON.parse(readFileSync(path.join(dir,name),'utf8'));const lines=(name:string)=>readFileSync(path.join(dir,name),'utf8').trim().split('\n').filter(Boolean).map(s=>JSON.parse(s));
const run=read('run.json'),s=read('snapshot.json'),requests=lines('requests.jsonl'),lifecycle=lines('lifecycle.jsonl'),sessions=lines('sessions.jsonl'),http=lines('target-http.jsonl');
const m=JSON.parse(readFileSync(path.join(run.dir,'meta.json'),'utf8')),db=new pg.Client({connectionString:m.dsn});await db.connect();
