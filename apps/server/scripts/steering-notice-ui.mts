// Isolated UI fixture; no model, no scheduler start and no target traffic.
import {mkdirSync,writeFileSync} from 'node:fs';
import {randomUUID} from 'node:crypto';
import {openDatabase} from '../src/db/index.js';
import {Engine,defaultEngineConfig} from '../src/engine/engine.js';
import {buildApp} from '../src/http/app.js';
import {signJWT,AUTH_PASSWORD_KEY,hashPassword} from '../src/http/auth.js';
process.env.SERIES_PG_DSN=`postgres://series:series@127.0.0.1:5433/fate_steering_ui_${process.pid}?sslmode=disable`;
process.env.SERIES_LOG_LEVEL='silent';
const db=await openDatabase(),dir='/tmp/fate-steering-notice-ui';mkdirSync(dir,{recursive:true});
await db.platform().setSetting(AUTH_PASSWORD_KEY,hashPassword('local-fixture-only'));
const task=await db.tasks().createTaskWithOptions('本地合成：纠偏提醒验收','仅供展示验证，不执行模型或目标操作',{executionMode:'manual'});
const store=db.exploration(task.exploration_id),intent=await store.addIntent({summary:'读取本地合成资料，保存观察并结束'},1,[],'user');
const turn='local-worker-turn',text='仅调整当前意图的验证方法，不扩展目标或完成条件。\n复用已保存的合成证据，不重复执行。\n正常完成当前工具后再读取纠偏。\n继续及时写回事实与发现。\n补齐当前意图缺失的结论，然后退出。\n第六行用于验证长正文展开与复制。';
const emit=(kind:string,extra:Record<string,unknown>={})=>store.appendActivity({worker:'work#1',node_id:intent,kind,...extra,metadata:{turn_id:turn,...extra.metadata as object}});
await emit('status',{metadata:{event_type:'turn_start',role:'worker',mode:'manual',started_at:new Date(Date.now()-50000).toISOString()}});
await emit('text',{summary:'开始处理本地合成资料。',metadata:{response:{stop_reason:'toolUse',has_tools:true,model:'LOCAL fixture',provider:'synthetic'},stream_id:'local-message-1'}});
await emit('tool_use',{tool:'context_get',tool_use_id:'local-read',summary:'{"ref":"node:1"}',detail:'{"ref":"node:1"}'});
const planner=await emit('status',{tool:'steer_work',summary:text,detail:text,metadata:{event_type:'steering',source:'planner',steering:{id:'local-planner',source:'planner',intent_id:intent,target_turn_id:turn,status:'submitted'}}});
await emit('tool_result',{tool:'context_get',tool_use_id:'local-read',summary:'LOCAL 合成资料读取完成',detail:'{"content":"LOCAL 合成资料读取完成"}'});
const main=await emit('status',{tool:'steer_work',summary:'按用户要求，仅整理现有资料，不新增探测。',detail:'按用户要求，仅整理现有资料，不新增探测。',metadata:{event_type:'steering',source:'mainagent',steering:{id:'local-main',source:'mainagent',intent_id:intent,target_turn_id:turn,status:'submitted'}}});
await emit('text',{summary:'本地合成资料已整理完成。',detail:'本地合成资料已整理完成。',metadata:{response:{stop_reason:'stop',has_tools:false,model:'LOCAL fixture',provider:'synthetic'},stream_id:'local-message-2'}});
await emit('result',{summary:'回复完成',metadata:{event_type:'lifecycle',status:'completed'}});
const legacy=await store.appendActivity({worker:'work#1',node_id:intent,kind:'user',summary:'历史纠偏，原来源未记录。\n保留原文，不猜测来源。\n状态也未记录。\n第四行全文。',detail:'历史纠偏，原来源未记录。\n保留原文，不猜测来源。\n状态也未记录。\n第四行全文。',metadata:{event_type:'steering'}});
await db.query("UPDATE exploration_nodes SET state='done',completed_at=now(),owner=NULL WHERE id=$1",[intent]);
await db.query("UPDATE tasks SET status='done' WHERE id=$1",[task.id]);
await store.appendActivity({worker:'main',kind:'user',summary:'这是一条真正的用户消息，仍应显示为用户气泡。',detail:'这是一条真正的用户消息，仍应显示为用户气泡。',metadata:{turn_id:'main-user'}});
const engine=new Engine(db,defaultEngineConfig(),async()=>{throw Error('UI fixture must not call a model');},dir),jwt=randomUUID();
const app=buildApp({db,engine,jwtKey:jwt,dataDir:dir,skillsRoot:dir,version:'steering-notice-isolated',startedAt:Date.now()});
await app.listen({host:'127.0.0.1',port:18987});
writeFileSync(`${dir}/token`,signJWT(jwt),{mode:0o600});
writeFileSync(`${dir}/state.json`,JSON.stringify({task:task.id,intent,turn,planner,main,legacy,database:`fate_steering_ui_${process.pid}`}));
console.log(JSON.stringify({task:task.id,intent,planner,main,legacy,port:18987}));
process.on('SIGTERM',async()=>{await engine.shutdown();await app.close();await db.close();process.exit(0);});
