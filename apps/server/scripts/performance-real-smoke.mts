import pg from 'pg';import {mkdtempSync,mkdirSync,writeFileSync} from 'node:fs';import {tmpdir} from 'node:os';import path from 'node:path';
import {openDatabase} from '../src/db/index.js';import {Engine,defaultEngineConfig} from '../src/engine/engine.js';import {makeModelResolver} from '../src/pi/modelResolver.js';import {configureAgentEnv} from '../src/agent/roles.js';
const live=new pg.Client({connectionString:'postgres://series:series@127.0.0.1:5433/series',options:'-c default_transaction_read_only=on -c statement_timeout=5s'});await live.connect();const profile=(await live.query('SELECT * FROM llm_profiles WHERE id=453')).rows[0];await live.end();if(!profile)throw new Error('Missing configured model');
const name=`fate_perf_real_${Date.now()}`,dir=mkdtempSync(path.join(tmpdir(),'fate-perf-real-')),out=path.resolve('../../docs/reviews/evidence/performance-20261026/real-smoke.json');
process.env.SERIES_PG_DSN=`postgres://series:series@127.0.0.1:5433/${name}`;const db=await openDatabase();const cols=Object.keys(profile);await db.query(`INSERT INTO llm_profiles(${cols.map(k=>'"'+k+'"').join(',')}) VALUES(${cols.map((_,i)=>'$'+(i+1)).join(',')}) ON CONFLICT(id) DO UPDATE SET ${cols.filter(k=>k!=='id').map(k=>'"'+k+'"=EXCLUDED."'+k+'"').join(',')}`,cols.map(k=>profile[k]));
await db.query('UPDATE agents SET max_turns=0,run_seconds=0');await db.query('UPDATE llm_profiles SET max_tokens=0');await db.query('UPDATE mcp_servers SET enabled=false');await db.platform().setSetting('workers','10');configureAgentEnv({skillsRoot:path.join(dir,'skills')});
const t=await db.tasks().createTaskWithOptions('LOCAL 性能修复真实模型冒烟；仅处理宿主提供的合成文本，不执行命令或访问网络','记录合成文本 PERF_LOCAL_OK；不要进行其他探测。',{executionMode:'manual',coverageEnabled:false,llmProfileIDs:[453]});const s=db.exploration(t.exploration_id);const id=await s.addIntent({summary:'这是隔离合成资料。输入文本 PERF_LOCAL_OK。请使用 record_fact 写入一条事实：summary=LOCAL 性能冒烟，evidence=宿主提供的合成文本 PERF_LOCAL_OK。无需工具探测，写回后正常总结。',dispatch_requested:true},5,[],'user');
const e=new Engine(db,{...defaultEngineConfig(),workerMaxTurns:0,workerMaxDurationMs:0,plannerMaxTurns:0},makeModelResolver(db),dir);
let result:any={database:name,task_id:t.id,intent_id:id,started_at:new Date().toISOString(),status:'running'};const save=()=>{mkdirSync(path.dirname(out),{recursive:true});writeFileSync(out,JSON.stringify(result,null,2));};save();
try{await e.run(t.id);for(;;){const node=await s.getNode(id);if(!['open','running'].includes(node!.state)){result.state=node!.state;result.stop=node!.payload.execution_stop;break;}await new Promise(r=>setTimeout(r,500));}result.status=result.state==='done'?'passed':'failed';}
catch(error){result.status='failed';result.error=String(error).split(String(profile.api_key)).join('[redacted]');}
finally{await e.shutdown();result.audit=(await db.query('SELECT role,status,usage,error FROM llm_request_attempts ORDER BY id')).rows;result.facts=(await s.listByKind('fact')).filter(n=>n.payload.from_intent===id).map(n=>({id:n.id,summary:n.payload.summary,from_intent:n.payload.from_intent}));result.finished_at=new Date().toISOString();save();await db.query("UPDATE llm_profiles SET api_key=''");await db.close();console.log(JSON.stringify({status:result.status,state:result.state,facts:result.facts,out}));}
