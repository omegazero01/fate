import {readFileSync,writeFileSync} from 'node:fs';import assert from 'node:assert/strict';import path from 'node:path';
const config=JSON.parse(readFileSync('/private/tmp/fate-series-mcp-active.json','utf8'));
const token=readFileSync(path.join(config.dir,'token'),'utf8');const api=async(route:string,body?:unknown)=>{const response=await fetch(`http://127.0.0.1:${config.port}${route}`,{method:body===undefined?'GET':'POST',headers:{'X-Series-Token':token,'Content-Type':'application/json'},body:body===undefined?undefined:JSON.stringify(body)});return{status:response.status,body:await response.json()};};
await api('/api/acceptance/capture',{});const r=JSON.parse(readFileSync(path.join(config.evidence,'run.json'),'utf8'));
assert.equal(r.task.status,'done');assert.equal(r.intents.length,2);assert(r.intents.every((i:any)=>i.state==='done'));assert.equal(r.facts.length,2);
const first=r.intents.find((i:any)=>i.id===3),second=r.intents.find((i:any)=>i.id===5);assert(second.payload.contract.basis.some((b:any)=>b.node_id===4));
for(const id of [3,4,5,6])assert(r.anchors.some((a:any)=>Number(a.node_id)===id&&Number(a.asset_id)===3));
assert(r.requests.every((q:any)=>Object.keys(q.output_limits).length===0));assert(r.runs.every((x:any)=>x.max_turns===0&&x.max_duration_ms===0));
const resumed=r.runs.filter((x:any)=>x.role==='worker'&&x.session_id===r.runs.find((x:any)=>x.role==='worker'&&x.stopReason==='aborted').session_id);assert.equal(resumed.length,2);assert.equal(resumed[1].stopReason,'completed');
const feedback=r.activity.filter((a:any)=>a.metadata?.worker_feedback);assert.equal(feedback.filter((a:any)=>a.metadata.worker_feedback.state==='done').length,1);assert(feedback.every((a:any)=>a.main_seg===2));assert(r.events.every((e:any)=>e.active_slots.length===0));
assert(r.mcp.some((m:any)=>m.tool==='ask_wiki_question'&&m.delivered_at&&m.delivered_at>resumed[1].started_at));
const oldMessages=await api('/api/tasks/1/intents/5/messages',{message:'LOCAL rejected compatibility input',request_id:'retired-endpoint'});assert.equal(oldMessages.status,410);
const assets=await api('/api/assets?task_id=1&limit=500'),counts=await api('/api/assets/counts?task_id=1');assert.equal(assets.body.total,Object.values(counts.body).reduce((n:any,v:any)=>n+v,0));
const result={passed:true,task_id:r.task_id,requests:r.requests.length,usage:r.attempts.map((a:any)=>a.usage).filter(Boolean),asset_counts:counts.body,asset_ids:r.assets.map((a:any)=>a.id),fact_ids:r.facts.map((f:any)=>f.id),intents:r.intents.map((i:any)=>({id:i.id,state:i.state,contract:i.payload.contract})),anchors:r.anchors,main_a:2,main_b:1,feedback:feedback.map((a:any)=>({id:a.id,main_seg:a.main_seg,...a.metadata.worker_feedback})),resumed_session:resumed.map((r:any)=>({session_id:r.session_id,session_path:r.session_path,reason:r.stopReason,started_at:r.started_at,finished_at:r.finished_at})),old_messages_status:oldMessages.status,all_output_limits_absent:true,budgets:r.budgets,errors:r.activity.filter((a:any)=>a.is_error).map((a:any)=>({id:a.id,tool:a.tool,detail:a.detail})),test_control:r.gate,observed_at:new Date().toISOString()};
writeFileSync(path.join(config.evidence,'verification.json'),JSON.stringify(result,null,2));console.log(JSON.stringify({passed:true,requests:r.requests.length,asset_counts:counts.body,facts:result.fact_ids,main_a:2,main_b:1}));
