    "@fastify/multipart": "9.3.0",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.1",
    "http-mitm-proxy": "1.1.0",
    "node-pty": "1.1.0",
    "pg": "^8.13.1",
    "tldts": "^7.4.18",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
