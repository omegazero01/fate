{
  "name": "@series/server",
  "version": "0.1.0",
  "private": true,
  "description": "SERIES TypeScript \u540e\u7aef\uff08pi SDK \u91cd\u6784\u7248\uff09",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/prepare-pty.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "node scripts/prepare-pty.mjs"
  },
  "dependencies": {
